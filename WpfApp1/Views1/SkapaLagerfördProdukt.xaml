<Page x:Class="WpfApp1.Views1.SkapaLagerfördProdukt"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="SkapaLagerfördProdukt" Background="#FF1A1A1D">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"  Margin = "0, 15, 0, 15" HorizontalAlignment = "Center" VerticalAlignment = "Center" FontSize = "28" FontWeight = "Bold" Text = "Skapa Specialbeställning" Foreground = "White" ></TextBlock >

            <Border Grid.Row = "1" Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Produkt namn" Foreground="#FFB08D46" Margin="0,0,10,0">
                        
                    </TextBlock>
                    <TextBox Width="245">
                        
                    </TextBox>
                </StackPanel>
            </Border>
            
            <Border Grid.Row = "1" Grid.Column="1" Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Pris" Foreground="#FFB08D46" Margin="0,0,10,0">

                    </TextBlock>
                    <TextBox Width="280">

                    </TextBox>
                </StackPanel>
            </Border>
            
            <Border Grid.Row = "2" Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Storlek" Foreground="#FFB08D46" Margin="0,0,10,0">

                    </TextBlock>
                    <TextBox Width="280">

                    </TextBox>
                </StackPanel>
            </Border>

            <Border Grid.Row = "2" Grid.Column="1" Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Typ" Foreground="#FFB08D46" Margin="0,0,10,0">

                    </TextBlock>
                    <TextBox Width="280">

                    </TextBox>
                </StackPanel>
            </Border>
            
            <Border Grid.Row = "3" Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Modell" Foreground="#FFB08D46" Margin="0,0,10,0">

                    </TextBlock>
                    <TextBox Width="280">

                    </TextBox>
                </StackPanel>
            </Border>
            
            <Border Grid.Row = "3" Grid.Column="1" Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Färg" Foreground="#FFB08D46" Margin="0,0,10,0">

                    </TextBlock>
                    <TextBox Width="280">

                    </TextBox>
                </StackPanel>
            </Border>

            <Border Grid.Row = "4" Grid.Column="0" Grid.ColumnSpan="2"  Background = "#FF2C3E50" Padding = "20" CornerRadius = "15" Margin = "10, 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dekoration" Foreground="#FFB08D46" Margin="0,0,10,0">

                    </TextBlock>
                    <TextBox Width="650">

                    </TextBox>
                </StackPanel>
            </Border>


            <Button Command="{Binding}" 
                    Grid.Row="7" 
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Content="LÄGG TILL PRODUKT I DATABAS" 
                    Height="45" 
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#FFB08D46">
            </Button>
        </Grid>
    </ScrollViewer>
    
</Page>
