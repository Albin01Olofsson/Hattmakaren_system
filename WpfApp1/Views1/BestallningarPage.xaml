<Page x:Class="WpfApp1.Views1.BestallningarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A1D">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>

        <!-- TOP BAR -->
        <Grid Margin="40,20,40,0">
            <Button Content="📦 Visa beställningar"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="10,5"
                    Background="#FF3A7CA5"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Command="{Binding NavigateToBestallningarListaCommand}"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Margin="0,60,0,0">
            <StackPanel Margin="40" Width="400">

                <!-- TITLE -->
                <TextBlock Text="Skapa beställning"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,25"/>

                <!-- MATERIAL -->
                <TextBlock Text="Material"
                           Foreground="#FFC5A059"
                           FontWeight="SemiBold"/>

                <ComboBox Height="40"
                          Margin="0,5,0,15"
                          Background="#FF2C3E50"
                          Foreground="Black"
                          BorderThickness="0"
                          Padding="5"
                          ItemsSource="{Binding MaterialLista}"
                          SelectedItem="{Binding SelectedMaterial}"
                          DisplayMemberPath="Namn"/>

                <!-- ANTAL -->
                <TextBlock Text="Mängd"
                           Foreground="#FFC5A059"
                           FontWeight="SemiBold"/>

                <TextBox Height="40"
                         Margin="0,5,0,20"
                         Background="#FF2C3E50"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="5"
                         Text="{Binding Antal, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- LEVERANTÖR -->
                <TextBlock Text="Leverantör"
                           Foreground="#FFC5A059"
                           FontWeight="SemiBold"/>

                <TextBox Height="40"
                         Margin="0,5,0,20"
                         Background="#FF2C3E50"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="5"
                         Text="{Binding LeverantörNamn, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- ADD ROW -->
                <Button Content="➕ Lägg till i beställning"
                        Height="40"
                        Background="#FF3A7CA5"
                        Foreground="White"
                        Margin="0,0,0,15"
                        Command="{Binding AddToBestallningCommand}"/>

                <!-- LIST -->
                <ListBox ItemsSource="{Binding BestallningsRader}" Margin="0,10,0,20">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding Material.Namn}" Width="120"/>
                                <TextBlock Text="{Binding Antal}" Width="40"/>
                                <TextBlock Text="{Binding Material.MåttText, Mode=OneWay}" Width="40"/>
                                <TextBlock Text="{Binding RadPris}" Width="80"/>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- CREATE -->
                <Button Content="Skapa beställning"
                        Height="45"
                        Background="#FFC5A059"
                        Foreground="#FF1A1A1D"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,25"
                        Command="{Binding SkapaBestallningCommand}"/>

                <!-- STATUS -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontWeight="Bold"
                           FontSize="14"
                           Background="#FF2C3E50"
                           Padding="10"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 🔥 KNAPP FLYTTAD HIT (fixar ditt problem) -->
                <Button Content="➕ Lägg till nytt material"
                        Height="40"
                        Margin="0,20,0,10"
                        Background="Transparent"
                        Foreground="#FFC5A059"
                        BorderBrush="#FFC5A059"
                        BorderThickness="1"
                        Command="{Binding ToggleMaterialFormCommand}"/>

                <!-- PDF -->
                <Button Content="Ladda ner som PDF"
                        Height="40"
                        Background="Gray"
                        Foreground="White"
                        Command="{Binding ExportPdfCommand}"
                        Margin="0,10,0,0"/>

                <!-- FORM -->
                <Border Background="#FF2C3E50"
                        Padding="20"
                        CornerRadius="12"
                        Margin="0,20,0,0"
                        Visibility="{Binding IsMaterialFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel>

                        <TextBlock Text="Nytt material"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Namn" Foreground="#FFC5A059"/>
                        <TextBox Height="35"
                                 Margin="0,5,0,10"
                                 Background="#FF1A1A1D"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="5"
                                 Text="{Binding Namn}"/>

                        <TextBlock Text="Pris" Foreground="#FFC5A059"/>
                        <TextBox Height="35"
                                 Margin="0,5,0,10"
                                 Background="#FF1A1A1D"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="5"
                                 Text="{Binding Pris}"/>

                        <TextBlock Text="Mått" Foreground="#FFC5A059"/>

                        <ComboBox Height="35"
                                  Margin="0,5,0,15"
                                  ItemsSource="{Binding MåttTyper}"
                                  SelectedItem="{Binding SelectedMåttTyp}"
                                  Background="White"
                                  Foreground="Black"/>

                        <Button Content="Spara material"
                                Height="40"
                                Background="#FFC5A059"
                                Foreground="#FF1A1A1D"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Command="{Binding AddMaterialCommand}"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>