                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Style="{StaticResource GlassFront}">
                        <TextBlock Text="" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Exempel
" Foreground="#888" HorizontalAlignment="Center" Margin="0,95,0,0"/>
                </Grid>

                <Grid Margin="15" Cursor="Hand">
                    <Border Style="{StaticResource GlassBack}">
                        <Border.Background>
