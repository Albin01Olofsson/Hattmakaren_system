<Page x:Class="WpfApp1.Views1.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1" xmlns:viewmodels="clr-namespace:WpfApp1.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:OrderVM}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#FF1A1A1D"
      Title="OrderPage">

    <StackPanel Orientation="Vertical"
                Margin="20">
        
        <TextBlock x:Name="Rubrik"
                   Text="ORDER"
                   Margin="0,0,0,10"
                   FontSize="28"
                   FontWeight="Black"
                   Foreground="#F4F1EA"
                   HorizontalAlignment="Center">
        </TextBlock>
        <Button Content="Gå till Skapa Order" 
        Click="BtnSkapaOrder_Click" 
        Width="200" Height="50" 
        Background="#FFB08D46" Foreground="White" 
        FontSize="16" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            
            <TextBox x:Name="SökFält"
                     Text="{Binding SökString, UpdateSourceTrigger=PropertyChanged}"
                     Width="290"
                     Height="33"
                     FontSize="16"
                     VerticalContentAlignment="Center">
                
            </TextBox>

            <Button x:Name="BtnSök"
                    Content="Sök"
                    Command="{Binding SökCommand}"
                    Padding="10,0"
                    Background="#FFC5A059"
                    Foreground="#F4F1EA"
                    FontWeight="Bold">
            </Button>
        
        </StackPanel>
        
        
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--SÖKRESULTAT-->
                <Border Grid.Column="0" Margin="0,0,20,0" Background="#FF2C3E50" CornerRadius="15" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding AntalOrders, StringFormat=Sökresultat: {0}}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#F4F1EA"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center">
                            
                        </TextBlock>

                        <ListBox x:Name="SökResultat"
                                 ItemsSource="{Binding OrderList}"
                                 SelectionChanged="SökResultat_SelectionChanged"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 MaxHeight="290">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="EttSökresultat"
                                          Background="#11FFFFFF">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="KundNamn" 
                                                   Grid.Column="0" 
                                                   Grid.Row="0" 
                                                   Text="{Binding Kund.Namn}"
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#F4F1EA" 
                                                   HorizontalAlignment="Center">
                                        </TextBlock>

                                        <TextBlock x:Name="OrderNummer" 
                                                   Grid.Column="0" 
                                                   Grid.Row="1" 
                                                   Text="{Binding OrderID, StringFormat=Order: {0}}"
                                                   FontSize="12" 
                                                   Foreground="#F4F1EA" 
                                                   HorizontalAlignment="Center">
                                        </TextBlock>

                                        
                                        <TextBlock x:Name="Datum"
                                                   Grid.Column="1"
                                                   Grid.Row="0"
                                                   Text="{Binding Datum, StringFormat=Datum: {0}}" 
                                                   FontSize="12" 
                                                   Foreground="#F4F1EA" 
                                                   HorizontalAlignment="Center">
                                            
                                        </TextBlock>

                                        <TextBlock x:Name="ÄrSpecialBeställning"
                                                   Grid.Column="1"
                                                   Grid.Row="1"
                                                   Text="{Binding IsSpecialbeställning, StringFormat=Specialbeställning: {0}}"
                                                   FontSize="12"
                                                   Foreground="#F4F1EA"
                                                   HorizontalAlignment="Center">
                                            
                                        </TextBlock>

                                        <TextBlock x:Name="ÄrMarkeradSomKlar"
                                                   Grid.Column="2"
                                                   Grid.Row="0"
                                                   Text="{Binding Färdig, StringFormat=Klar: {0}}" 
                                                   FontSize="12"
                                                   Foreground="#F4F1EA"
                                                   HorizontalAlignment="Center">
                                            
                                        </TextBlock>
                                        <TextBlock x:Name="OrderStartare" 
                                                   Grid.Column="2"
                                                   Grid.Row="1" 
                                                   Text="{Binding StartadAv.Namn, StringFormat=Startare: {0}}" 
                                                   FontSize="12" 
                                                   Foreground="#F4F1EA"
                                                   HorizontalAlignment="Center">
                                            
                                        </TextBlock>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            <!--FILTER-->
            <Border x:Name="FilterBar"
                    Grid.Column="1"
                    Background="#FFC5A059"
                    CornerRadius="15"
                    Padding="10">
                <StackPanel Orientation="Vertical">
                    <!--RUBRIK-->
                    <TextBlock Text="Filter" 
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#F4F1EA"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Center">
                    </TextBlock>
                    
                    <!--DATUM-->
                    <TextBlock Text="Datum Från" FontWeight="Bold" Foreground="#F4F1EA"></TextBlock>
                    <DatePicker SelectedDate="{Binding DatumFrånFilter}" Margin="0,0,0,10"></DatePicker>
                    
                    <TextBlock Text="Datum till" FontWeight="Bold" Foreground="#F4F1EA"></TextBlock>
                    <DatePicker SelectedDate="{Binding DatumTillFilter}" Margin="0,0,0,10"></DatePicker>
                    
                    <!--ORDER STARTARE-->
                    <TextBlock Text="Order Startare" FontWeight="Bold" Foreground="#F4F1EA"></TextBlock>

                    <ComboBox x:Name="OrderStartareComboBox"
                              ItemsSource="{Binding OrderStartareNamnList}"
                              SelectedItem="{Binding OrderStartareFilter}"
                              Margin="0,0,0,10">
                    </ComboBox>
                    
                    <!--MARKERAD SOM KLAR-->
                    <TextBlock Text="Markerad som klar" FontWeight="Bold" Foreground="#F4F1EA"></TextBlock>
                    <ComboBox x:Name="MarkeradSomKlarComboBox"
                              SelectedValue="{Binding KlarFilter}"
                              Margin="0,0,0,10"
                              SelectedValuePath="Content"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Ospecificerat"></ComboBoxItem>
                        <ComboBoxItem Content="Klar"></ComboBoxItem>
                        <ComboBoxItem Content="Ej Klar"></ComboBoxItem>
                    </ComboBox>
                    
                    <!--Specialbeställning-->
                    <TextBlock Text="Specialbeställning" FontWeight="Bold" Foreground="#F4F1EA"></TextBlock>
                    <ComboBox x:Name="SpecialbeställningComboBox"
                              SelectedValue="{Binding SpecialBeställningFilter}"
                              Margin="0,0,0,10"
                              SelectedValuePath="Content"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Ospecificerat"></ComboBoxItem>
                        <ComboBoxItem Content="Ja"></ComboBoxItem>
                        <ComboBoxItem Content="Nej"></ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>
    
    </StackPanel>
</Page>
