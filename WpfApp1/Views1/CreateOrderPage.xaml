<Page x:Class="WpfApp1.Views1.CreateOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="CreateOrderPage" Background="#FF1A1A1D" Height="778">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="0, 15, 0, 15" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="Bold" Text="Skapa Order" Foreground="White"></TextBlock>

            <Border Grid.Row="1" Background="#FF2C3E50" Padding="20" CornerRadius="15" Margin="10, 10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Kundens Epost: " Margin="0, 15" Foreground="#FFC5A059"></TextBlock>
                        <TextBox Width="200" Margin="0, 15"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="200" Margin="50, 15" HorizontalAlignment="Right" Content="Ny Kund" Background="#FFB08D46" Click="Button_Click"></Button>
                    <RichTextBox Grid.Row="1" Margin="50, 15" HorizontalAlignment="Left" VerticalAlignment="Bottom"></RichTextBox>
                </Grid>
            </Border>


            <Border Grid.Row="2" Background="#FF2C3E50" Padding="20" CornerRadius="15" Margin="10, 10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock  Text="Produkt" Foreground="#FFC5A059"></TextBlock>
                    <Grid Width="200" Margin="50, 15, 0, 15" HorizontalAlignment="Left">
                        <ComboBox x:Name="ProduktVal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFB08D46">

                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#FFB08D46"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>

                            <ComboBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="#FFB08D46"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>

                        <TextBlock Text="Välj Produkt" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Opacity="0.8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ProduktVal, Path=SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="1" Width="150" Content="Specialbeställning" Margin="0, 15, 50, 15" HorizontalAlignment="Left" Background="#FFB08D46"></Button>
                    <Button Grid.Column="1" Width="150" Content="Lägg Till Produkt" Margin="0, 15, 50, 15" HorizontalAlignment="Right" Background="#FFB08D46"></Button>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#FF2C3E50" Padding="20" CornerRadius="15" Margin="10, 10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Material" Foreground="#FFC5A059"></TextBlock>
                    <Button Grid.Column="1" Width="200" Margin="0, 15, 50, 15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Lägg Till Material" Background="#FFB08D46"></Button>
                    <ComboBox Width="200" Margin="50, 15, 0, 50" HorizontalAlignment="Left" ItemsSource="{Binding material}" SelectedItem="{Binding valtMaterial}" Text="Välj Material"></ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="50, 0, 0, 15" VerticalAlignment="Bottom">
                        <TextBox Width="200"/>
                        <TextBlock Text="meter" VerticalAlignment="center" Foreground="#FFC5A059"/>
                    </StackPanel>
                </Grid>
            </Border>


            <Border Grid.Row="4" Background="#FF2C3E50" Padding="20" CornerRadius="15" Margin="10, 10">
                <Grid>
                    <TextBlock Text="Rabatt" Foreground="#FFC5A059"></TextBlock>
                    <TextBox Width="200" Margin="50, 15" HorizontalAlignment="Left"></TextBox>
                    <Button Grid.Row="4" Width="200"  Margin="50, 15" HorizontalAlignment="Right" Content="Lägg Till Rabatt" Background="#FFB08D46"></Button>
                </Grid>
            </Border>

            <Border Grid.Row="5" Background="#FF2C3E50" Padding="20" CornerRadius="15" Margin="10, 10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Översikt" Foreground="#FFB08D46"></TextBlock>
                    <RichTextBox Margin="50, 15"></RichTextBox>
                    <Button Grid.Column="1" Width="200" Margin="50, 15" HorizontalAlignment="Right" Content="Lägg Order" Background="#FFB08D46"></Button>
                </Grid>
            </Border>



        </Grid>
    </Grid>
</Page>
