<Page x:Class="WpfApp1.Views1.LagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LagerPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" Width="900">

            <TextBlock Text="Lager"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Lagersaldo"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#FFC5A059"
                       Margin="0,0,0,15"/>

            <DataGrid ItemsSource="{Binding MaterialLista}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Background="#FF2C3E50"
                      Foreground="White"
                      BorderBrush="#FFC5A059"
                      BorderThickness="1"
                      RowBackground="#FF1A1A1D"
                      AlternatingRowBackground="#FF2C3E50"
                      Height="300"
                      Margin="0,0,0,30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MaterialID}" Width="80"/>
                    <DataGridTextColumn Header="Namn" Binding="{Binding Namn}" Width="*"/>
                    <DataGridTextColumn Header="Typ" Binding="{Binding Typ}" Width="150"/>
                    <DataGridTextColumn Header="Pris" Binding="{Binding Pris}" Width="120"/>
                    <DataGridTextColumn Header="Lagersaldo" Binding="{Binding Lagerantal}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="#FF2C3E50"
                    Padding="20"
                    CornerRadius="12">
                <StackPanel>

                    <TextBlock Text="Lägg till nytt material"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Namn" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,10"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Namn}"/>

                    <TextBlock Text="Pris" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,10"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Pris}"/>

                    <TextBlock Text="Typ (meter/st)" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,10"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Typ}"/>

                    <TextBlock Text="Startlager" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Lagerantal}"/>

                    <Button Content="Spara material"
                            Height="40"
                            Background="#FFC5A059"
                            Foreground="#FF1A1A1D"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Command="{Binding AddMaterialCommand}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
