<Page x:Class="WpfApp1.Views1.Planneringsviews.AnvPage"
      KeepAlive="True"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1.Planneringsviews" 
      xmlns:viewmodels="clr-namespace:WpfApp1.ViewModels"
      xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Scheduler;assembly=Syncfusion.SfScheduler.WPF"
      mc:Ignorable="d"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AnvPage" Background="#FF1A1A1D">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#FFC5A059" CornerRadius="0, 0, 15, 15" Panel.ZIndex="10">
            <StackPanel>
                <TextBlock Text="Ditt Schema" FontSize="28" FontWeight="Bold" Margin="30, 0"/>
                <Menu Margin="50,0" Background="#FFC5A059" FontWeight="Bold">
                    <MenuItem Header="Ordrar" Click="Ordrar_Click"/>
                    <MenuItem Header="Plannering"/>
                    <MenuItem Header="Material"/>
                    <Button Content="+ Aktivitet" Command="{Binding ÖppnaLäggTillAktivitetCommand}" Background="#FF8A2BE2" Margin="10,0"/>
                    <ComboBox SelectedItem="{Binding ValtSchemaLäge, Mode=TwoWay}">
                        <sys:String>Alla scheman</sys:String>
                        <sys:String>Mitt schema</sys:String>
                    </ComboBox>
                </Menu>
            </StackPanel>
        </Border>

        <Border Grid.Row="1">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

               

                <syncfusion:SfScheduler Grid.Row="1" 
                                        ViewType="Week" 
                                        EnableToolTip="True"
                                        AppointmentDropping="Kalender_AppointmentDropping"
                                        ItemsSource="{Binding Schema}">

                    <syncfusion:SfScheduler.DaysViewSettings>
                        <syncfusion:DaysViewSettings StartHour="7" EndHour="16"/>
                    </syncfusion:SfScheduler.DaysViewSettings>

                    <syncfusion:SfScheduler.AppointmentMapping>
                        <syncfusion:AppointmentMapping 
                            Subject="Titel"          
                            StartTime="StartTid"     
                            EndTime="SlutTid"        
                            AppointmentBackground="Färg" />
                    </syncfusion:SfScheduler.AppointmentMapping>

                    <syncfusion:SfScheduler.ToolTipTemplate>
                        <DataTemplate>
                            <Border Background="#222" Padding="10" CornerRadius="6" BorderBrush="#FFC5A059" BorderThickness="1">
                                <StackPanel Width="180">

                                    <TextBlock Text="{Binding Data.ProduktNamn}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Data.AnvändarNamn}" Foreground="#DDFFFFFF"/>

                                    <TextBlock Foreground="#AAFFFFFF">
                    <Run Text="Order: "/>
                    <Run Text="{Binding Data.OrderId}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="#AAFFFFFF">
                    <Run Text="ProduktID: "/>
                    <Run Text="{Binding Data.ProduktId}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="#AAFFFFFF" Text="{Binding Data.StartTid, StringFormat='Start: {0:HH:mm}'}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                                        <Button Content="Delete" 
                            Command="{Binding DataContext.DeleteBokningCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                            CommandParameter="{Binding Data.Id}"/>

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </syncfusion:SfScheduler.ToolTipTemplate>

                </syncfusion:SfScheduler>

            </Grid>
        </Border>

        <Border Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding MånadsvySynlig, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Calendar SelectedDate="{Binding ValtDatum, Mode=TwoWay}" DisplayDate="{Binding NuvarandeMåndag}"/>
                <Button Content="Stäng" Width="100" Margin="10" Command="{Binding StängMånadsvyCommand}"/>
            </StackPanel>
        </Border>
    </Grid>

</Page>
