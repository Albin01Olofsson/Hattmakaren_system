<Grid>
    <Grid>
        <Image Source="DinBakgrundsBild.jpg" Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect Radius="36" />
            </Image.Effect>
        </Image>
    </Grid>

    <Border Width="539" Height="676" CornerRadius="40" VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#373B4B" Opacity="0.6" />
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#44FFFFFF" Offset="0" />
                <GradientStop Color="#11FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" Color="Black" Opacity="0.3" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            
            <StackPanel Margin="0,0,0,50">
                <TextBlock Text="HATTMAKAREN" FontSize="42" FontWeight="Bold" Foreground="#5270A3" HorizontalAlignment="Center" />
                <TextBlock Text="HATTMAKAREN" FontSize="42" FontWeight="Bold" Foreground="#5270A3" HorizontalAlignment="Center" Opacity="0.3">
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleY="-1" CenterY="20" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="Email" Foreground="#5270A3" FontWeight="Bold" Margin="0,0,0,5" />
            <Border Background="White" CornerRadius="15" Height="50" Margin="0,0,0,20">
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0" FontSize="16" />
            </Border>

            <TextBlock Text="Lösenord" Foreground="#5270A3" FontWeight="Bold" Margin="0,0,0,5" />
            <Border Background="White" CornerRadius="15" Height="50" Margin="0,0,0,10">
                <PasswordBox x:Name="PassInput" PasswordChanged="PassInput_PasswordChanged"
                             Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0" FontSize="16" />
            </Border>

            <TextBlock Text="{Binding LoginFel}" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,0,0,10" Height="20" />

            <Button Command="{Binding LoginCommand}" Width="200" Height="55" Margin="0,20,0,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="25" BorderThickness="1" BorderBrush="#7091F8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#1F227C" Offset="0" />
                                    <GradientStop Color="#030A2B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="LOGGA IN" Foreground="White" FontWeight="Bold" FontSize="18" />
            </Button>

        </StackPanel>
    </Border>
</Grid>