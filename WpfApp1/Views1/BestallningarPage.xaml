<Page x:Class="WpfApp1.Views1.BestallningarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A1D">

    <ScrollViewer>
        <StackPanel Margin="40" Width="400">

            <!-- Titel -->
            <TextBlock Text="Skapa beställning"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,25"/>

            <!-- Material -->
            <TextBlock Text="Material"
                       Foreground="#FFC5A059"
                       FontWeight="SemiBold"/>

            <ComboBox Height="40"
                      Margin="0,5,0,15"
                      Background="#FF2C3E50"
                      Foreground="Black"
                      BorderThickness="0"
                      Padding="5"
                      ItemsSource="{Binding MaterialLista}"
                      SelectedItem="{Binding SelectedMaterial}"
                      DisplayMemberPath="Namn"/>

            <!-- Mängd -->
            <TextBlock Text="Mängd (meter)"
                       Foreground="#FFC5A059"
                       FontWeight="SemiBold"/>

            <TextBox Height="40"
                     Margin="0,5,0,20"
                     Background="#FF2C3E50"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="5"
                     Text="{Binding Antal, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Skapa beställning -->
            <Button Content="Skapa beställning"
                    Height="45"
                    Background="#FFC5A059"
                    Foreground="#FF1A1A1D"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Margin="0,0,0,25"
                    Command="{Binding SkapaBestallningCommand}"/>

            <Button Content="Ladda ner som PDF"
        Height="40"
        Background="Gray"
        Foreground="White"
        Command="{Binding ExportPdfCommand}"
        Margin="0,10,0,0"/>

            <!-- Lägg till material -->
            <Button Content="➕ Lägg till nytt material"
                    Height="40"
                    Background="Transparent"
                    Foreground="#FFC5A059"
                    BorderBrush="#FFC5A059"
                    BorderThickness="1"
                    Command="{Binding ToggleMaterialFormCommand}"/>

            <!-- FORM (du kan styra synlighet senare via VM) -->
            <Border Background="#FF2C3E50"
                    Padding="20"
                    CornerRadius="12"
                    Margin="0,20,0,0">

                <StackPanel>

                    <TextBlock Text="Nytt material"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Namn" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,10"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Namn}"/>

                    <TextBlock Text="Pris" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,10"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Pris}"/>

                    <TextBlock Text="Typ (meter/st)" Foreground="#FFC5A059"/>
                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Background="#FF1A1A1D"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="5"
                             Text="{Binding Typ}"/>

                    <Button Content="Spara material"
                            Height="40"
                            Background="#FFC5A059"
                            Foreground="#FF1A1A1D"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Command="{Binding AddMaterialCommand}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>