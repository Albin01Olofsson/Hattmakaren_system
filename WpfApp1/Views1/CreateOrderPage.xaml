<Page x:Class="WpfApp1.Views1.CreateOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="CreateOrderPage" Background="#FF1A1A1D">

    <Page.Resources>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#FFB08D46"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC5A059"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="750">

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="SKAPA ORDER" 
                               FontSize="28" 
                               FontWeight="Black" 
                               Foreground="#F4F1EA" 
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnSkapaLagerfördProdukt_Click" Content="Ny Lagerförd" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button Click="BtnSkapaSpecialbeställning_Click" Content="Ny Specialbeställning" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FF2C3E50" Padding="20" CornerRadius="8" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Välj Kund:" Foreground="#FFC5A059" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AllaKunder}" 
                                  SelectedItem="{Binding ValdKund}" 
                                  DisplayMemberPath="Namn" 
                                  Height="32" 
                                  Margin="0,0,15,0"
                                  VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" Content="+ Ny Kund" Click="Button_Click" Style="{StaticResource ActionButtonStyle}"/>
                    </Grid>
                </Border>

                <Border Background="#FF2C3E50" Padding="20" CornerRadius="8" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Välj Produkt:" Foreground="#FFC5A059" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AllaProdukter}" 
                                  SelectedItem="{Binding ValdProdukt}" 
                                  Height="32" 
                                  Margin="0,0,15,0"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Namn">
                            
                        </ComboBox>

                        <Button Grid.Column="2" Content="Lägg Till" Command="{Binding LaggTillProduktCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    </Grid>
                </Border>

                <Border Background="#FF2C3E50" Padding="20" CornerRadius="8" Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Prioritet:" Foreground="#FFC5A059" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                  IsChecked="{Binding IsPrioVald}" 
                                  Content="Markera som Prio-order (+20% på priset)" 
                                  Foreground="White" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rabatt (kr):" Foreground="#FFC5A059" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding Rabatt}" 
                                 Height="32" 
                                 Width="150" 
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,15,0"/>
                        <Button Grid.Row="1" Grid.Column="2" 
                                Content="Uppdatera Pris" 
                                Command="{Binding LaggTillRabattCommand}" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Background="#FF4F5D75" Foreground="White"/>
                    </Grid>
                </Border>

                <Border Background="#FF2C3E50" Padding="20" CornerRadius="8" Margin="0,0,0,25">
                    <StackPanel>
                        <Button Content="HämtaFraktalternativ" Command="{Binding HämtaFraktValCommand}" Width="100" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}"/>
                        <ListBox ItemsSource="{Binding FraktVal}" SelectedItem="{Binding ValtFraktAlternativ}" Margin="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Namn}" FontWeight="Bold" Width="120"/>
                                        <TextBlock Text="{Binding Pris, StringFormat='{}{0:C}'}" Width="80"/>
                                        <TextBlock Text="{Binding LeveransTid, StringFormat='{}{0} dagar'}" Width="80"/>
                                        <TextBlock Text="{Binding Typ}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="#FF1A1A1D" BorderBrush="#FFC5A059" BorderThickness="2" Padding="25" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="ORDERÖVERSIKT" Foreground="#FFC5A059" FontWeight="Black" FontSize="18" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding OrderOversiktText}" 
                                   Foreground="#F4F1EA" 
                                   FontSize="15" 
                                   LineHeight="24"
                                   Margin="0,0,0,25"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <Button Content="SPARA ORDER I DATABAS" 
                                Command="{Binding LaggOrderCommand}"
                                Height="50" 
                                FontSize="18" 
                                FontWeight="Black"
                                Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>