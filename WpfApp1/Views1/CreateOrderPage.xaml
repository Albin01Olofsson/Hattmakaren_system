<Page x:Class="WpfApp1.Views1.CreateOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="778" d:DesignWidth="800"
      Title="CreateOrderPage" Background="#FF1A1A1D">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Skapa Order" FontSize="26" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Välj Kund: " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>
                    <ComboBox Width="250" 
                              ItemsSource="{Binding AllaKunder}" 
                              SelectedItem="{Binding ValdKund}" 
                              DisplayMemberPath="Namn"/>
                    <Button Content="Ny Kund" Margin="20,0,0,0" Width="100" Background="#FFB08D46" Command="{Binding NyKundCommand}"/>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Välj Produkt: " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>
                    <ComboBox Width="250" 
                              ItemsSource="{Binding AllaProdukter}" 
                              SelectedItem="{Binding ValdProdukt}" 
                              DisplayMemberPath="namn"/>
                    <Button Content="Lägg Till" Margin="20,0,0,0" Width="100" Background="#FFB08D46" Command="{Binding LaggTillProduktCommand}"/>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rabatt (kr): " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>
                    <TextBox Width="100" Text="{Binding Rabatt}"/>
                    <Button Content="Aktivera Rabatt" Margin="20,0,0,0" Width="130" Background="#FFB08D46" Command="{Binding LaggTillRabattCommand}"/>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="20" CornerRadius="10" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="ORDERÖVERSIKT" Foreground="#FFB08D46" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding OrderOversiktText}" Foreground="White" FontSize="16" Margin="0,0,0,20"/>
                    <Button Content="SPARA ORDER I DATABAS" Height="45" FontSize="18" Background="#FFB08D46" Command="{Binding LaggOrderCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>