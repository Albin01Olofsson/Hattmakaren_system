<Page x:Class="WpfApp1.Views1.SeFörfrågningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="SeFörfrågningPage"
      Background="#FF1A1A1D">


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25">
            <TextBlock x:Name="Rubrik"
                   Text="{Binding Avsändare, StringFormat=Från: {0}}"
                   Margin="0,0,0,10"
                   FontSize="22"
                   FontWeight="Black"
                   Foreground="#F4F1EA"
                   HorizontalAlignment="Center"/>

            <Border Background="#FF2C3E50"
                Height="auto"
                CornerRadius="15"
                Padding="10">


                <StackPanel>

                    <TextBlock Text="{Binding Ämne, StringFormat=Ämne: {0}}"
                           FontSize="16"             
                           Foreground="#F4F1EA"   
                           FontWeight="DemiBold">
                    </TextBlock>

                    <TextBlock Text="{Binding Datum, StringFormat=Datum: {0}}"
                           FontSize="16"
                           Foreground="#F4F1EA" 
                           FontWeight="DemiBold">
                    </TextBlock>

                    <TextBlock Text="Förfrågan"
                           Margin="0,10,0,0" 
                           FontSize="16" 
                           FontWeight="UltraBold"
                           Foreground="#F4F1EA">
                    </TextBlock>

                    <TextBlock  Text="{Binding Innehåll}"
                            FontSize="16" 
                            Foreground="#F4F1EA"
                            TextWrapping="Wrap" 
                            Margin="0,8,0,0">

                    </TextBlock>
                </StackPanel>


            </Border>
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1"
                    Background="#FFB08D46"
                    CornerRadius="15"
                    Padding="10">
                    <!--<Image Source="{Binding BildSökVäg}"
                           MaxWidth="312"
                           MaxHeight="172"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                </Image>-->
                    <Image x:Name="MailBild"
                           MaxWidth="312"
                           MaxHeight="172"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    </Image>

                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>


</Page>
