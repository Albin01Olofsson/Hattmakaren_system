<Page x:Class="WpfApp1.Views1.SpårningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="spårningPage" Background="#FF1A1A1D" Height="800">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="125"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#FF2C3E50" CornerRadius="10" Margin="10">
                <TextBlock Text="Leveransspårning" Foreground="#FFC5A059" Margin="25" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="3" Background="#FF2C3E50" CornerRadius="10" Margin="10" Padding="15">
                <gmap:GMapControl x:Name="MainMap"/>
            </Border>

            <Grid Grid.Row="4" Grid.RowSpan="2" Background="#FF2C3E50" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!--<Button Content="Skickad" Command="{Binding MarkeraSomSkickadCommand}" Background="#FFC5A059" Foreground="Black" Margin="10,15"/>-->
                
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Välj en order" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox Grid.Row="1" x:Name="Leveranslista" ItemsSource="{Binding PlockadeOrdrar}" SelectionChanged="Leveranslista_SelectionChanged" Background="#FF34495E" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding OrderID, StringFormat='Order #{0}'}" Foreground="#FFC5A059" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Kund.Namn}" Foreground="#FFC5A059" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Händelser" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Uppdateringar}" SelectionChanged="HändelserLista_SelectionChanged" Background="#ff34495E" Foreground="#FFC5A059" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Tidpunkt, StringFormat='{}{0:d MMM HH:mm}'}" Foreground="#FFC5A059" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Plats}" Foreground="#FFC5A059" FontSize="12"/>
                                    <TextBlock Text="{Binding Meddelande}" Foreground="#FFC5A059" FontSize="11" FontStyle="Italic"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
               
                

            </Grid>
        </Grid>
    </Grid>
</Page>
