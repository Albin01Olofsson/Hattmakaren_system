<Page x:Class="WpfApp1.Views1.Mainpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mainpage" Background="Transparent">

    <Page.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootLayout">
        <Grid x:Name="BackgroundLayer">
            <Image Source="/Images/00bce0939f636f2927b42f74f38d896a.jpg" Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="80"/>
                </Image.Effect>
            </Image>
            <Rectangle Fill="#0D0D0D" Opacity="0.6"/>
        </Grid>

        <Grid x:Name="MainInterface">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="#15FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="LogoArea" Grid.Row="0" Margin="0,50,0,30">
                        <TextBlock Text="HATTMAKAREN" FontWeight="Bold" HorizontalAlignment="Center" FontSize="24" Opacity="0.8">
                            <TextBlock.Foreground>
                                <RadialGradientBrush>
                                    <GradientStop Color="Black"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </RadialGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="MenuContainer" Margin="10,0">
                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnAnvandare_Click">
                                <TextBlock Text="Användare" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnKunder_Click">
                                <TextBlock Text="Kunder" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnLager_Click">
                                <TextBlock Text="Lager" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnOrder_Click">
                                <TextBlock Text="Order" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnSchema_Click">
                                <TextBlock Text="Schema" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnBestallningar_Click">
                                <TextBlock Text="Beställningar" Foreground="White" FontSize="16"/>
                            </Button>

                            <Rectangle Height="1" Fill="White" Opacity="0.1" Margin="15,20"/>

                            <Button Style="{StaticResource MenuButtonStyle}" Click="BtnLoggaUt_Click">
                                <TextBlock Text="Logga ut" FontWeight="Bold" Foreground="White" FontSize="14" TextDecorations="Underline"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="20,0,20,30" Padding="15" Background="#10FFFFFF" CornerRadius="15">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="30" Height="30" Fill="#40FFFFFF"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="UserNameText" Text="Admin" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="RoleText" Text="Online" Foreground="White" Opacity="0.5" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="60">
                <StackPanel x:Name="DashboardStartView" Visibility="Visible">
                    <TextBlock Text="DASHBOARD" FontSize="12" Foreground="White" Opacity="0.4" FontWeight="Bold"/>
                    <TextBlock Text="Välkommen tillbaka" FontSize="42" Foreground="White" FontWeight="Thin" Margin="0,5,0,50"/>
                    <UniformGrid Columns="3">
                        <Border x:Name="Card1" Background="#15FFFFFF" Padding="30" CornerRadius="20" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="AKTIVA ORDER" Foreground="White" Opacity="0.5"/>
                                <TextBlock Text="14" FontSize="56" Foreground="White" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Card2" Background="#15FFFFFF" Padding="30" CornerRadius="20" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="VARNINGAR" Foreground="White" Opacity="0.5"/>
                                <TextBlock Text="03" FontSize="56" Foreground="White" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Card3" Background="#25FFFFFF" Padding="30" CornerRadius="20" Margin="15,0,0,0">
                            <StackPanel>
                                <TextBlock Text="INTÄKT IDAG" Foreground="White" Opacity="0.5"/>
                                <TextBlock Text="12 450 kr" FontSize="36" Foreground="White" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated" Margin="0"/>
            </Grid>
        </Grid>
    </Grid>
</Page>