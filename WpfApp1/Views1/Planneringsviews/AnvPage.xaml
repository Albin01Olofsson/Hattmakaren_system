<Page x:Class="WpfApp1.Views1.Planneringsviews.AnvPage"
      KeepAlive="True"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:scheduler="clr-namespace:Syncfusion.UI.Xaml.Scheduler;assembly=Syncfusion.SfScheduler.WPF"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AnvPage" Background="#FF121212">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ModernActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF6200EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#FFC5A059" CornerRadius="0, 0, 20, 20" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>

            <Grid Margin="30,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ditt Schema" Grid.Column="0" VerticalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#FF1A1A1D"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--OrderKnapp-->
                    <Button Content="+ Ordrar" Click="Ordrar_Click" Background="#FF2C3E50" 
                            Foreground="White" FontWeight="Bold" Padding="12,6" 
                            Margin="10,0,0,0" Height="36"/>
                    <!--AktivitetKnapp-->
                    <Button Content="+ Ny Aktivitet" Command="{Binding ÖppnaLäggTillAktivitetCommand}" 
                            Background="#FF2C3E50" Foreground="White" FontWeight="Bold" Padding="12,6" 
                            Margin="20,0"  Height="36"/>
                    <!--SchemaLäge-->
                    <ComboBox SelectedItem="{Binding ValtSchemaLäge, Mode=TwoWay}" 
                              Width="140" Height="30" VerticalContentAlignment="Center">
                        <sys:String>Alla scheman</sys:String>
                        <sys:String>Mitt schema</sys:String>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="15,10,15,15" Background="#FF2C3E50" CornerRadius="15">
            <Grid Margin="5">
                <syncfusion:SfScheduler x:Name="Kalender" ViewType="Week" EnableToolTip="False" BorderThickness="0"
                                        AppointmentTapped="Kalender_AppointmentTapped" AppointmentDropping="Kalender_AppointmentDropping"
                                        ItemsSource="{Binding Schema}">

                    <syncfusion:SfScheduler.Resources>
                        <Style TargetType="syncfusion:AllDayAppointmentPanel">
                            <Setter Property="Height" Value="60"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Background" Value="White"/>
                            
                        </Style>
                    </syncfusion:SfScheduler.Resources>

                    <syncfusion:SfScheduler.DaysViewSettings>
                        <syncfusion:DaysViewSettings StartHour="7" EndHour="17" />
                    </syncfusion:SfScheduler.DaysViewSettings>

                    <syncfusion:SfScheduler.AppointmentMapping>
                        <syncfusion:AppointmentMapping Subject="Titel" StartTime="StartTid" EndTime="SlutTid"        
                                                       AppointmentBackground="Färg" IsAllDay="ÄrHeldag" />
                    </syncfusion:SfScheduler.AppointmentMapping>
                </syncfusion:SfScheduler>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2" Background="#AA000000" Panel.ZIndex="100"
                Visibility="{Binding MånadsvySynlig, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FF2D2D30" Padding="25" CornerRadius="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Calendar SelectedDate="{Binding ValtDatum, Mode=TwoWay}" DisplayDate="{Binding NuvarandeMåndag}"/>
                    <Button Content="Stäng" Style="{StaticResource ModernActionButton}" 
                            Width="120" Margin="0,20,0,0" Background="#FF3700B3"
                            Command="{Binding StängMånadsvyCommand}"/>
                </StackPanel>
            </Border>
        </Border>
        <Popup x:Name="AppointmentPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FF2D2D30" CornerRadius="12" BorderBrush="#FFC5A059" BorderThickness="1" Padding="15" Width="220">
                <StackPanel>
                    <!-- Titel -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding ValdAktivitet.Typ}" Foreground="#FFC5A059"/>
                        <TextBlock Text=":  " Foreground="#FFC5A059"/>
                        <TextBlock Text="{Binding ValdAktivitet.Titel}" Foreground="White"/>
                    </StackPanel>

                    <!-- Skapare -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Skapad av:  " Foreground="#FFC5A059"/>
                        <TextBlock Text="{Binding ValdAktivitet.AnvändarNamn}" Foreground="#B0FFFFFF"/>
                    </StackPanel>

                    <!-- DELTAGARE LISTA -->
                    <StackPanel Visibility="{Binding ValdAktivitet.HarDeltagare, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Deltagare:  " Foreground="#FFC5A059"/>
                        <ItemsControl ItemsSource="{Binding ValdAktivitet.DeltagareNamn}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B0FFFFFF" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- PLANERINGSECTION -->
                    <StackPanel Visibility="{Binding ValdAktivitet.ÄrPlanering, Converter={StaticResource BoolToVis}}" >
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Order:  " Foreground="#FFC5A059"/>
                            <TextBlock Text="{Binding ValdAktivitet.OrderId}" Foreground="#B0FFFFFF"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Produkt:  " Foreground="#FFC5A059"/>
                            <TextBlock Text="{Binding ValdAktivitet.ProduktNamn}" Foreground="#B0FFFFFF"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tid -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Start tid:  " Foreground="#FFC5A059"/>
                        <TextBlock Text="{Binding ValdAktivitet.StartTid, StringFormat=HH:mm}" Foreground="#B0FFFFFF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Slut tid:  " Foreground="#FFC5A059"/>
                        <TextBlock Text="{Binding ValdAktivitet.SlutTid, StringFormat=HH:mm}"  Foreground="#B0FFFFFF"/>
                    </StackPanel>

                    <!-- Ta bort -->
                    <Button Content="Ta bort" Command="{Binding TaBortValdCommand}" IsEnabled="{Binding KanTaBortVald}" Background="#FFCF6679" Foreground="White" Padding="8" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>