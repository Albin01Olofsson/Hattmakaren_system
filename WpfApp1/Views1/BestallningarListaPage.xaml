<Page x:Class="WpfApp1.Views1.BestallningarListaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A1D">

    <Grid>

        <!-- TOP BAR -->
        <Grid Margin="40,20,40,0">
            <Button Content="⬅ Tillbaka"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="10,5"
                    Background="#FF2C3E50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Command="{Binding GoBackCommand}"/>
        </Grid>

        <!-- CONTENT -->
        <ScrollViewer Margin="0,60,0,0">
            <StackPanel Margin="40">

                <!-- TITLE -->
                <TextBlock Text="📦 Alla beställningar"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,25"/>
                <StackPanel Orientation="Horizontal" Margin="40,10,40,10">

                    <TextBlock Text="Filter:"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <ComboBox Width="160"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>

                </StackPanel>
                <!-- LIST -->
                <ItemsControl ItemsSource="{Binding Bestallningar}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#FF2C3E50"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,20">

                                <StackPanel>

                                    <!-- LEVERANTÖR -->
                                    <TextBlock Text="{Binding Leverantör}"
                                               Foreground="#FFC5A059"
                                               FontSize="18"
                                               FontWeight="Bold"/>

                                    <!-- DATUM -->
                                    <TextBlock Text="{Binding Datum, StringFormat='Datum: {0:yyyy-MM-dd HH:mm}'}"
                                               Foreground="LightGray"
                                               FontSize="12"
                                               Margin="0,0,0,10"/>

                                    <!-- ID -->
                                    <TextBlock Text="Beställning ID:"
                                               Foreground="Gray"/>
                                    <TextBlock Text="{Binding MaterialBeställningID}"
                                               Foreground="White"
                                               Margin="0,0,0,15"/>

                                    <!-- HEADER -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Material"
                                                   Foreground="Gray"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Antal"
                                                   Foreground="Gray"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="Pris"
                                                   Foreground="Gray"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- RADER -->
                                    <ItemsControl ItemsSource="{Binding Rader}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Material -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Material.Namn}"
                                                               Foreground="White"/>

                                                    <!-- Antal + Mått -->
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Antal}"
                                                                   Foreground="White"/>
                                                        <TextBlock Text=" "
                                                                   Foreground="White"/>
                                                        <TextBlock Text="{Binding Material.MåttText, Mode=OneWay}"
                                                                   Foreground="White"/>
                                                    </StackPanel>

                                                    <!-- Pris -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding RadPris, StringFormat='{}{0} kr'}"
                                                               Foreground="#FFC5A059"
                                                               HorizontalAlignment="Right"/>
                                                    
                                                </Grid>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <!-- Divider -->
                                    <Border Height="1"
                                            Background="#FF1A1A1D"
                                            Margin="0,12,0,12"/>

                                    <!-- TOTAL -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <ComboBox Width="160"
                                                  Margin="0,0,0,10"
                                                  SelectedValue="{Binding Levererad, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="ComboBox_SelectionChanged">

                                            <ComboBoxItem Content="Beställd" Tag="False"/>
                                            <ComboBoxItem Content="Levererad" Tag="True"/>

                                        </ComboBox>
                                        <TextBlock Text="Total: "
                                                   Foreground="Gray"
                                                   FontSize="14"/>

                                        <TextBlock Text="{Binding TotalPris, StringFormat='{}{0} kr'}"
                                                   Foreground="LightGreen"
                                                   FontWeight="Bold"
                                                   FontSize="16"/>
                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>