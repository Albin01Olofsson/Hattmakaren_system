<Page x:Class="WpfApp1.Views1.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="LoginPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="450" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FFC5A059">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontSize="40" Text="AFFÄRSSYSTEM" FontWeight="Bold" Foreground="#FF2C3E50" Margin="0,0,0,10"/>
                <TextBlock Text="Hattmakarna &amp; Co" FontSize="25" FontWeight="Bold" FontStyle="Italic" Foreground="#FF2C3E50" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="#FF2C3E50">
            <Border Width="320" VerticalAlignment="Center" Background="#FF34495E" CornerRadius="25" Padding="30">
                <StackPanel>

                    <Grid Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <Ellipse Stroke="White" StrokeThickness="2" Fill="#3e5871"/>
                        <TextBlock Text="👤" FontSize="45" Foreground="#FFC5A059" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Margin="0,0,0,5"/>
                    </Grid>

                    <Border Background="White" Height="40" CornerRadius="10" Margin="0,0,0,15">
                        <Grid Margin="10,0">
                            <TextBlock Text="Email" Foreground="DarkGray" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Email}" Value=""><!--// Empty string-->
                                                <Setter Property="Visibility" Value="Visible"/> <!--// Show placeholder when Email is empty-->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Email}" Value="{x:Null}"><!--// Null value-->
                                                <Setter Property="Visibility" Value="Visible"/> <!--// Hide placeholder when Email is null-->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Background="White" Height="40" CornerRadius="10" Margin="0,0,0,30">
                        <Grid Margin="10,0">
                            <TextBlock Text="Lösenord" Foreground="DarkGray" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="PasswordPlaceholder">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PassInput}" Value="True"><!--// When PasswordBox is focused, hide the placeholder-->
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Password, ElementName=PassInput}" Value=""><!--// When PasswordBox is empty, show the placeholder-->
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <PasswordBox x:Name="PassInput" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" PasswordChanged="PassInput_PasswordChanged"/>
                        </Grid>
                    </Border>

                    <Button Content="LOGGA IN" Command="{Binding LoginCommand}" Cursor="Hand" 
                            Background="#FFC5A059" Foreground="#FF2C3E50" FontSize="16" 
                            FontWeight="Bold" Height="45" BorderThickness="0"><!--// Click="LoginButton_Click"-->
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <!--<Button Content="LOGGA IN" Click="LoginButton_Click" Cursor="Hand"
                            Background="#FFC5A059" Foreground="#FF2C3E50" FontSize="16" 
                            FontWeight="Bold" Height="45" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>-->

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>