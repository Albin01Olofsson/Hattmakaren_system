<Page x:Class="WpfApp1.Views1.OrderBeskrivningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      xmlns:viewmodels="clr-namespace:WpfApp1.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:OrderBeskrivningVM}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Background="#FF1A1A1D"
      Title="OrderBeskrivningPage">

    <Page.Resources>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#FFB08D46"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC5A059"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="DetailLabel">
            <Setter Property="Foreground" Value="#FFC5A059"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DetailValue">
            <Setter Property="Foreground" Value="#F4F1EA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="Rubrik"
                           Grid.Column="0"
                           Grid.Row="0"
                           Text="{Binding OrdernsID, StringFormat='Ordernr: #{0}'}"
                           FontSize="32"
                           FontWeight="Black"
                           Foreground="#F4F1EA"
                           VerticalAlignment="Center">
                </TextBlock>

                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <TextBlock Text="Status:" Foreground="#FFC5A059" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox Width="150" 
                              Height="35" 
                              Margin="0,0,15,0"
                              SelectedValue="{Binding OrderStatus, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Content"
                              VerticalContentAlignment="Center"
                              SelectionChanged="OrderStatus_SelectionChanged">
                        <ComboBoxItem Content="Ej Påbörjad"/>
                        <ComboBoxItem Content="Påbörjad"/>
                        <ComboBoxItem Content="Levererad"/>
                    </ComboBox>

                    <Button x:Name="LaddaNerPdfKnapp" 
                            Click="LaddaNerPdfKnapp_Click" 
                            Content="Ladda ner PDF" 
                            Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>

                <Border Grid.Column="0" Grid.Row="1" Margin="0,30,20,0" Background="#FF2C3E50" CornerRadius="10" Padding="25" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ORDERDETALJER" FontSize="18" FontWeight="Black" Foreground="#FFC5A059" Margin="0,0,0,20"/>
                            <Button  Grid.Column="1" 
                                     x:Name="BtnSkrivUtFraktsedel"
                                     Click="BtnSkrivUtFraktsedel_Click"  
                                     Content="Skriv ut fraktsedel"
                                     Height="39"          
                                     Width="140"         
                                     HorizontalAlignment="Right"    
                                     Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Kund:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding KundNamn}" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Säljare:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OrderStartareNamn}" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Datum:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding Datum, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Specialbeställning:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding IsSpecialbeställning}" Style="{StaticResource DetailValue}"/>
                        </StackPanel>

                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Margin="0,10,0,20"/>

                        <TextBlock Text="PRODUKTER" FontWeight="Bold" Foreground="#FFC5A059" Margin="0,0,0,10"/>

                        <ListBox ItemsSource="{Binding ProdukLista}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Margin="0,0,0,20"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#11FFFFFF" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Namn}" Foreground="#F4F1EA" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Pris, StringFormat='{}{0} kr'}" Foreground="#FFC5A059" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#FF1A1A1D" CornerRadius="5" Padding="15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Rabatt:" Foreground="LightGray" Width="100"/>
                                    <TextBlock Text="{Binding Rabatt, StringFormat='{}{0} %'}" Foreground="LightGray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Slutsumma:" Foreground="#FFC5A059" FontWeight="Black" FontSize="16" Width="100"/>
                                    <TextBlock Text="{Binding Pris, StringFormat='{}{0} kr'}" Foreground="#F4F1EA" FontWeight="Black" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" Margin="0,30,0,0" Background="#FFB08D46" CornerRadius="10" Padding="15" VerticalAlignment="Top" MaxWidth="350">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Tillägsbeskrivningar av special tillverkningar" Margin="0,0,0,8" FontWeight="Black" FontSize="14" Foreground="#F4F1EA"/>


                        <ListBox ItemsSource="{Binding SpecialBeställningarLista}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF2C3E50" Margin="0,15,0,0" Padding="15" CornerRadius="8">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding Namn}" Margin="0,0,0,8" FontWeight="Black" FontSize="14" Foreground="#FFC5A059"/>
                                            <Image Source="{Binding BildFullPath}"></Image>
                                            <TextBlock Text="{Binding Beskrivning}" Margin="0,0,0,8" FontWeight="Black" FontSize="14" Foreground="#FFC5A059"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
