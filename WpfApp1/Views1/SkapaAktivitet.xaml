<Window x:Class="WpfApp1.Views1.SkapaAktivitet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views1"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Skapa Planering" Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A1D">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="20">
                <StackPanel>
                    <TextBlock Text="Planera Arbete" FontSize="24" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Namn (Frivilligt)" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PlaneringsNamn}" Margin="0,0,0,20" Padding="5" 
                             ToolTip="Lämnas tomt så används produktens namn automatiskt."/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Välj order" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AllaOrdrar}" SelectedItem="{Binding ValdOrder, Mode=TwoWay}" 
                                      DisplayMemberPath="OrderID" Padding="5"/>
                            <TextBlock Text="{Binding OrdrarFel}" Foreground="#FFFF6B6B" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Välj produkt" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AllaProdukter}" SelectedItem="{Binding ValdProdukt, Mode=TwoWay}" 
                                      DisplayMemberPath="Namn" Padding="5"/>
                            <TextBlock Text="{Binding ProdukterFel}" Foreground="#FFFF6B6B" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="#FF455A64" BorderThickness="0,1,0,0" Margin="0,5,0,20"/>
                   
                    <!--Start-->
                    <TextBlock Text="När ska arbetet påbörjas?" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- StartTid/Datum Text -->
                        <TextBlock Text="Datum" Grid.Row="0" Grid.Column="0" Foreground="#FFC5A059" FontWeight="Bold"/>
                        <TextBlock Text="Timme" Grid.Row="0" Grid.Column="1" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Minut" Grid.Row="0" Grid.Column="2" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Center"/>

                        <!-- StartTid/Datum INPUTS -->
                        <DatePicker Grid.Row="1" Grid.Column="0" SelectedDate="{Binding ValdStartTid}" Height="30"/>

                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding ValdStartTimme, Mode=TwoWay}" Background="#FF1A1A1D" Foreground="Black" Margin="5">
                            <sys:Int32>7</sys:Int32>
                            <sys:Int32>8</sys:Int32>
                            <sys:Int32>9</sys:Int32>
                            <sys:Int32>10</sys:Int32>
                            <sys:Int32>11</sys:Int32>
                            <sys:Int32>12</sys:Int32>
                            <sys:Int32>13</sys:Int32>
                            <sys:Int32>14</sys:Int32>
                            <sys:Int32>15</sys:Int32>
                            <sys:Int32>16</sys:Int32>
                        </ComboBox>

                        <ComboBox Grid.Row="1" Grid.Column="2" SelectedItem="{Binding ValdStartMinut, Mode=TwoWay}" Background="#FF1A1A1D" Foreground="Black" Margin="5">
                            <sys:Int32>0</sys:Int32>
                            <sys:Int32>15</sys:Int32>
                            <sys:Int32>30</sys:Int32>
                            <sys:Int32>45</sys:Int32>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding StartTidFel}" Foreground="#FFFF6B6B" FontSize="11" Margin="0,0,0,5"/>

                    <!--Slut-->
                    <TextBlock Text="När beräknas det vara klart?" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- SlutTid/Datum Text -->
                        <TextBlock Text="Datum" Grid.Row="0" Grid.Column="0" Foreground="#FFC5A059" FontWeight="Bold"/>
                        <TextBlock Text="Timme" Grid.Row="0" Grid.Column="1" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Minut" Grid.Row="0" Grid.Column="2" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Center"/>

                        <!-- SlutTid/Datum INPUTS -->
                        <DatePicker Grid.Row="1" Grid.Column="0" SelectedDate="{Binding ValdSlutTid}" Height="30"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding ValdSlutTimme, Mode=TwoWay}" Background="#FF1A1A1D" Foreground="Black" Margin="5">
                            <sys:Int32>7</sys:Int32>
                            <sys:Int32>8</sys:Int32>
                            <sys:Int32>9</sys:Int32>
                            <sys:Int32>10</sys:Int32>
                            <sys:Int32>11</sys:Int32>
                            <sys:Int32>12</sys:Int32>
                            <sys:Int32>13</sys:Int32>
                            <sys:Int32>14</sys:Int32>
                            <sys:Int32>15</sys:Int32>
                            <sys:Int32>16</sys:Int32>
                        </ComboBox>

                        <ComboBox Grid.Row="1" Grid.Column="2" SelectedItem="{Binding ValdSlutMinut, Mode=TwoWay}" Background="#FF1A1A1D" Foreground="Black" Margin="5">
                            <sys:Int32>0</sys:Int32>
                            <sys:Int32>15</sys:Int32>
                            <sys:Int32>30</sys:Int32>
                            <sys:Int32>45</sys:Int32>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="{Binding StartTidFel}" Grid.Row="2" Grid.Column="0" Foreground="#FFFF6B6B" FontSize="11" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TimmarFel}" Grid.Row="2" Grid.Column="0" Foreground="#FFFF6B6B" FontSize="11" Margin="0,-20,0,5"/>

                     <Button Content="Spara Till Kalendern" Height="45" Background="#FFB08D46" Foreground="Black" FontSize="14" FontWeight="Bold" Cursor="Hand"
                            BorderThickness="0" Margin="0, 10,0,0" Command="{Binding SparaAktivitetCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>