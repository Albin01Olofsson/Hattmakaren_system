<Page x:Class="WpfApp1.Views1.FörfrågningarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FörfrågningarPage"
      Background="#FF1A1A1D">

    <StackPanel Orientation="Vertical"
                Margin="20">
        <TextBlock x:Name="Rubrik"
           Text="FÖRFRÅGNINGAR"
           Margin="0,0,0,10"
           FontSize="28"
           FontWeight="Black"
           Foreground="#F4F1EA"
           HorizontalAlignment="Center">
        </TextBlock>

        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">

            <TextBox x:Name="SökFält"
             Text="{Binding SökString, UpdateSourceTrigger=PropertyChanged}"
             Width="290"
             Height="33"
             FontSize="16"
             VerticalContentAlignment="Center">

            </TextBox>

            <Button x:Name="BtnSök"
            Content="Sök"
            Command="{Binding SökCommand}"
            Padding="10,0"
            Background="#FFC5A059"
            Foreground="#F4F1EA"
            FontWeight="Bold">
            </Button>
        </StackPanel>

        <Border Margin="0,10,20,0" Background="#FF2C3E50" CornerRadius="15, 15, 0, 0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sortera efter: "  FontWeight="Bold" Foreground="#F4F1EA"></TextBlock>
                <ComboBox Width="100" HorizontalAlignment="Right">
                    <ComboBoxItem Content="Nyast"></ComboBoxItem>
                    <ComboBoxItem Content="Äldst"></ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Border>


        <Border Margin="0, 0,20,0" Background="#FF2C3E50" CornerRadius="0, 0, 15, 15" Padding="10, 0, 0, 0">
            <ScrollViewer>
                
                <ListBox Background="Transparent"
                         ItemsSource="{Binding}"
                         SelectionChanged="SökResultat_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Height="290">
                    
                </ListBox>
            </ScrollViewer>
        </Border>
    </StackPanel>
</Page>
