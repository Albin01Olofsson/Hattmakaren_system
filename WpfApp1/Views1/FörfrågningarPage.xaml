<Page x:Class="WpfApp1.Views1.FörfrågningarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FörfrågningarPage"
      Background="#FF1A1A1D">

    <StackPanel Orientation="Vertical" Margin="20">
        <TextBlock x:Name="Rubrik"
                   Text="FÖRFRÅGNINGAR"
                   Margin="0,0,0,10"
                   FontSize="28"
                   FontWeight="Black"
                   Foreground="#F4F1EA"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <TextBox x:Name="SökFält"
                     Text="{Binding SökString, UpdateSourceTrigger=PropertyChanged}"
                     Width="290"
                     Height="33"
                     FontSize="16"
                     VerticalContentAlignment="Center" />

            <Button x:Name="BtnSök"
                    Content="Sök"
                    Command="{Binding SökCommand}"
                    Padding="10,0"
                    Background="#FFC5A059"
                    Foreground="#F4F1EA"
                    FontWeight="Bold" />
        </StackPanel>

        <Border Margin="0,10,20,0"
                Background="#FF2C3E50"
                CornerRadius="15,15,0,0"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sortera efter: "
                           FontWeight="Bold"
                           Foreground="#F4F1EA" />
                <ComboBox Width="100"
                          HorizontalAlignment="Right"
                          SelectionChanged="Sortering_SelectionChanged">
                    <ComboBoxItem Content="Nyast" />
                    <ComboBoxItem Content="Äldst" />
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Margin="0,0,20,0"
                Background="#FF2C3E50"
                CornerRadius="0,0,15,15"
                Padding="10">

            <ListBox Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Mails}"
                     SelectionChanged="SökResultat_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Height="290">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder"
                                Margin="0,6,0,6"
                                Padding="12"
                                Background="#FF34495E"
                                CornerRadius="10"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Ämne}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#F4F1EA"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Datum}"
                                           FontSize="12"
                                           Foreground="#BBBBBB"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Margin="10,0,0,0" />

                                <TextBlock Text="{Binding Avsändare}"
                                           FontSize="13"
                                           Foreground="#D6D6D6"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Margin="0,6,0,0" />

                                <TextBlock Text="{Binding Innehåll}"
                                           FontSize="12"
                                           Foreground="#AAAAAA"
                                           Grid.Row="2"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           MaxHeight="40" />
                            </Grid>
                        </Border>

                        <!--<DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#242d45" />
                            </Trigger>
                        </DataTemplate.Triggers>-->
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </StackPanel>
</Page>
