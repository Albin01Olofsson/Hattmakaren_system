<Window x:Class="WpfApp1.Views1.SkapaAktivitet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views1"
        mc:Ignorable="d"
        Title="SkapaAktivitet" Height="450" Width="778">
    <Grid>
        <Border Background="#FF2C3E50"
       Padding="20"
       CornerRadius="15"
       Margin="20">

            <StackPanel Margin="20">

                <!-- Titel -->
                <TextBlock Text="Ny aktivitet" FontSize="22" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Välj en order -->
                <TextBlock Text="Välj en order" Foreground="#FFC5A059"/>
                <ComboBox  ItemsSource="{Binding AllaOrdrar}" SelectedItem="{Binding ValdOrder}" 
                           DisplayMemberPath="OrderID" Margin="0,5,0,10"/>
                
                <!-- Välj en produkt-->
                <TextBlock Text="Välj en produkt" Foreground="#FFC5A059"/>
                <ComboBox  ItemsSource="{Binding AllaProdukter}" SelectedItem="{Binding ValdProdukt}" 
                           DisplayMemberPath="namn" Margin="0,5,0,10"/>
                
                <!--välj datum-->
                <TextBlock Text="Datum" Foreground="#FFC5A059"/>
                <DatePicker SelectedDate="{Binding ValdStartTid}" Margin="0,5,0,10"/>

                <!--völj tid-->
                <TextBlock Text="Starttid (timme)" Foreground="#FFC5A059"/>
                <TextBox Text="{Binding ValdStartTimme}" Margin="0,5,0,10"/>
                
                <!-- Knapp -->
                <Button Content="Spara aktivitet" Height="40" Background="#FFB08D46" Foreground="Black" 
                        FontWeight="Bold" Command="{Binding SparaAktivitetCommand}"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
