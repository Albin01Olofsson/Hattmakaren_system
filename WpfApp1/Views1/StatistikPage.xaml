<Page x:Class="WpfApp1.Views1.StatistikPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1000"
      Background="#FF1A1A1D"
      Title="StatistikPage">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F1EA"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="STATISTIK"
                           FontSize="28"
                           FontWeight="Black"/>
                <TextBlock Text="{Binding PeriodText}"
                           Foreground="#FFC5A059"
                           FontWeight="Bold"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Background="#FF2C3E50"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Från" VerticalAlignment="Center" FontWeight="Bold"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding DatumFran, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Till" VerticalAlignment="Center" FontWeight="Bold" Margin="12,0,0,0"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding DatumTill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Rensa"
                            Command="{Binding RensaDatumFilterCommand}"
                            Background="#FFB08D46"
                            Foreground="#FF1A1A1D"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Nyckeltal}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF2C3E50"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding Rubrik}"
                                       Foreground="{Binding AccentFarg}"
                                       FontWeight="Bold"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Varde}"
                                       FontSize="24"
                                       FontWeight="Black"
                                       Margin="0,6,0,1"/>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding Detalj}"
                                       TextWrapping="Wrap"
                                       Opacity="0.72"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FF2C3E50"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Material"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Nuvarande lager och materialvärde"
                                   Opacity="0.65"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MaterialStatistik}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Rubrik}" FontWeight="Bold"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Antal}" FontWeight="Bold"/>
                                        </DockPanel>
                                        <Border Height="10" Background="#22000000" CornerRadius="5" Margin="0,7,0,5">
                                            <Border Width="{Binding Bredd}"
                                                    Background="#FFC5A059"
                                                    CornerRadius="5"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                        <TextBlock Text="{Binding Detalj}" Opacity="0.78"/>
                                        <TextBlock Text="{Binding SekundarDetalj}" Opacity="0.58"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#FF2C3E50"
                    CornerRadius="8"
                    Padding="14"
                    Margin="5,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Hattar"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Hattstatistik för vald period"
                                   Opacity="0.65"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HattStatistik}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Rubrik}" FontWeight="Bold"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Antal}" FontWeight="Bold"/>
                                        </DockPanel>
                                        <Border Height="10" Background="#22000000" CornerRadius="5" Margin="0,7,0,5">
                                            <Border Width="{Binding Bredd}"
                                                    Background="#FF2ECC71"
                                                    CornerRadius="5"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                        <TextBlock Text="{Binding Detalj}" Opacity="0.78"/>
                                        <TextBlock Text="{Binding SekundarDetalj}" Opacity="0.58"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FF2C3E50"
                    CornerRadius="8"
                    Padding="14"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Kunder"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Mest aktiva kunder i perioden"
                                   Opacity="0.65"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding KundStatistik}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Rubrik}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Antal}" FontWeight="Bold"/>
                                        </DockPanel>
                                        <Border Height="10" Background="#22000000" CornerRadius="5" Margin="0,7,0,5">
                                            <Border Width="{Binding Bredd}"
                                                    Background="#FFF59E0B"
                                                    CornerRadius="5"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                        <TextBlock Text="{Binding Detalj}" Opacity="0.78"/>
                                        <TextBlock Text="{Binding SekundarDetalj}" Opacity="0.58"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="{Binding UppdateradText}"
                               HorizontalAlignment="Right"
                               Opacity="0.55"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
