<Page x:Class="WpfApp1.Views1.LagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF121214">

    <Page.Resources>

        <!-- Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF20252B"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="BorderBrush" Value="#33C5A059"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="LagerDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#FF171A1F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FF171A1F"/>
            <Setter Property="AlternatingRowBackground" Value="#FF222831"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="MinHeight" Value="210"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#FF1A1A1D"/>
            <Setter Property="Background" Value="#FFE8D7B0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Editor -->
        <Style x:Key="EditorLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC5A059"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="#FF14171C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334A5568"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="EditorSaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.2*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- VÄNSTER INNEHÅLL -->
        <ScrollViewer Grid.Column="0"
                      x:Name="LeftScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Width="{Binding ElementName=LeftScroll, Path=ViewportWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Lager"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Översikt över material, hattar och aktuellt lagersaldo"
                               FontSize="14"
                               Foreground="#FFB8B8B8"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Material card -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Material i lager"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Material som används vid tillverkning"
                                           FontSize="13"
                                           Foreground="#FFB8B8B8"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Style="{StaticResource LagerDataGridStyle}"
                                  ItemsSource="{Binding FiltreradMaterialLista}"
                                  SelectedItem="{Binding SelectedMaterial}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding MaterialID}" Width="1*"/>
                                <DataGridTextColumn Header="Namn" Binding="{Binding Namn}" Width="2.5*"/>
                                <DataGridTextColumn Header="Mått" Binding="{Binding MåttText}" Width="1.5*"/>
                                <DataGridTextColumn Header="Pris" Binding="{Binding Pris}" Width="1.3*"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Lagerantal}" Width="1.3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Hattar card -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Hattar i lager"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Färdiga lagerförda produkter"
                                           FontSize="13"
                                           Foreground="#FFB8B8B8"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Style="{StaticResource LagerDataGridStyle}"
                                  ItemsSource="{Binding ProduktLista}"
                                  SelectedItem="{Binding SelectedProdukt}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ProduktID}" Width="1*"/>
                                <DataGridTextColumn Header="Namn" Binding="{Binding Namn}" Width="2.6*"/>
                                <DataGridTextColumn Header="Storlek" Binding="{Binding Storlek}" Width="1.4*"/>
                                <DataGridTextColumn Header="Pris" Binding="{Binding Pris}" Width="1.3*"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Lagerantal}" Width="1.3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Grid.Row="3"
                        Background="#FF20252B"
                        CornerRadius="18"
                        Padding="20"
                        BorderBrush="#33C5A059"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Åtgärder"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                        <WrapPanel>
                            <Button Content="Nytt material"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#FF3A7CA5"
                                    Foreground="White"
                                    Command="{Binding OppnaNyttMaterialCommand}"/>

                            <Button Content="Redigera material"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#FFC5A059"
                                    Foreground="#FF1A1A1D"
                                    Command="{Binding OppnaRedigeraMaterialCommand}"/>

                            <Button Content="Ny hatt"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#FF5C4B8A"
                                    Foreground="White"
                                    Command="{Binding OppnaNyProduktCommand}"/>

                            <Button Content="Redigera hatt"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#FF8E7DBE"
                                    Foreground="White"
                                    Command="{Binding OppnaRedigeraProduktCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- HÖGERPANEL -->
        <Border Grid.Column="2"
                Background="#FF20252B"
                CornerRadius="20"
                Padding="26"
                BorderBrush="#44C5A059"
                BorderThickness="1"
                MinWidth="330">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="{Binding EditorTitel}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Fyll i uppgifterna och spara ändringen"
                               Foreground="#FFB8B8B8"
                               FontSize="13"
                               Margin="0,0,0,24"/>

                    <!-- Material editor -->
                    <Border Margin="0,0,0,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaterialEditorVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="Materialnamn" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding MaterialNamn}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Text="Materialtyp / Mått" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding MaterialTyp}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Text="Pris" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding MaterialPris}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Text="Saldo" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding MaterialSaldo}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <Button Content="Spara material"
                                    Style="{StaticResource EditorSaveButtonStyle}"
                                    Background="#FFC5A059"
                                    Foreground="#FF1A1A1D"
                                    Command="{Binding SparaMaterialCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Hatt editor -->
                    <Border Margin="0,0,0,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProduktEditorVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="Hattnamn" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding ProduktNamn}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Text="Storlek" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding ProduktStorlek}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Text="Pris" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding ProduktPris}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <TextBlock Text="Saldo" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBox Text="{Binding ProduktSaldo}" Style="{StaticResource EditorTextBoxStyle}"/>

                            <Button Content="Spara hatt"
                                    Style="{StaticResource EditorSaveButtonStyle}"
                                    Background="#FF8E7DBE"
                                    Foreground="White"
                                    Command="{Binding SparaProduktCommand}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Stäng"
                            Height="44"
                            Background="Transparent"
                            Foreground="#FFC5A059"
                            BorderBrush="#FFC5A059"
                            BorderThickness="1"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Command="{Binding StangEditorCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>