<Page x:Class="WpfApp1.Views1.BestallningarListaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A1D">

    <ScrollViewer>
        <StackPanel Margin="40">

            <TextBlock Text="Alla beställningar"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <ListBox ItemsSource="{Binding Bestallningar}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF2C3E50" Padding="10" Margin="0,5">
                            <StackPanel>

                                <TextBlock Text="Beställning"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                <ItemsControl ItemsSource="{Binding Rader}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Material.Namn}" Width="120"/>
                                                <TextBlock Text="{Binding Antal}" Width="50"/>
                                                <TextBlock Text="{Binding RadPris}" Width="80"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding TotalPris}"
                                           Foreground="LightGreen"
                                           FontWeight="Bold"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </ScrollViewer>
</Page>