                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="White" Opacity="0.3"/>
                </TextBlock.Effect>
            </TextBlock>

            <UniformGrid Columns="3" Rows="2" Margin="60,0,60,0">

                <Grid Margin="15" Cursor="Hand">
                    <Border Style="{StaticResource GlassBack}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0066FF" Offset="0"/>
