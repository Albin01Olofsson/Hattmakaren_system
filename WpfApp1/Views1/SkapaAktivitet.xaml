<Window x:Class="WpfApp1.Views1.SkapaAktivitet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views1"
        mc:Ignorable="d"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="SkapaAktivitet" Height="550" Width="778">
    <Grid>
        <Border Background="#FF2C3E50"
       Padding="20"
       CornerRadius="15"
       Margin="20">

            <StackPanel Margin="20">

                <!-- Titel -->
                <TextBlock Text="Ny aktivitet" FontSize="22" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Välj en order -->
                <TextBlock Text="Välj en order" Foreground="#FFC5A059"/>
                <TextBlock Text="{Binding OrdrarFel}" Foreground="Red" FontSize="10"/>
                <ComboBox  ItemsSource="{Binding AllaOrdrar}" SelectedItem="{Binding ValdOrder, Mode=TwoWay}" 
                           DisplayMemberPath="OrderID" Margin="0,5,0,10"/>
                
                <!-- Välj en produkt-->
                <TextBlock Text="Välj en produkt" Foreground="#FFC5A059"/>
                <TextBlock Text="{Binding ProdukterFel}" Foreground="Red" FontSize="10"/>
                <ComboBox  ItemsSource="{Binding AllaProdukter}" SelectedItem="{Binding ValdProdukt, Mode=TwoWay}" 
                           DisplayMemberPath="namn" Margin="0,5,0,10"/>
                
                <!--välj datum-->
                <TextBlock Text="Datum" Foreground="#FFC5A059"/>
                <TextBlock Text="{Binding StartTidFel}" Foreground="Red" FontSize="10"/>
                <DatePicker SelectedDate="{Binding ValdStartTid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                <!--völj tid-->
                <TextBlock Text="Starttid (timme)" Foreground="#FFC5A059"/>
                <TextBlock Text="{Binding TimmarFel}" Foreground="Red" FontSize="10"/>
                <ComboBox SelectedItem="{Binding ValdStartTimme, Mode=TwoWay}" SelectedIndex="-1" IsSynchronizedWithCurrentItem="False" Margin="0,5,0,10">
                    <ComboBox.Items>
                        <sys:Int32>8</sys:Int32>
                        <sys:Int32>9</sys:Int32>
                        <sys:Int32>10</sys:Int32>
                        <sys:Int32>11</sys:Int32>
                        <sys:Int32>12</sys:Int32>
                        <sys:Int32>13</sys:Int32>
                        <sys:Int32>14</sys:Int32>
                        <sys:Int32>15</sys:Int32>
                        <sys:Int32>16</sys:Int32>
                    </ComboBox.Items>
                </ComboBox>

                <!-- Knapp -->
                <Button Content="Spara aktivitet" Height="40" Background="#FFB08D46" Foreground="Black" 
                        FontWeight="Bold" Command="{Binding SparaAktivitetCommand}"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
