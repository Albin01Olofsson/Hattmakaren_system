<Page x:Class="WpfApp1.Views1.CreateOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="778" d:DesignWidth="800"
      Title="CreateOrderPage" Background="#FF1A1A1D">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
       
          <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Skapa Order" FontSize="26" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <Button Click="BtnSkapaSpecialbeställning_Click" Grid.Column="1" Content="Skapa special beställning" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10" Margin="0,0,15,0" Background="#FFC5A059" Foreground="#F4F1EA"></Button>
                </Grid>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Välj Kund: " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>
                    <ComboBox Width="250" 
                              ItemsSource="{Binding AllaKunder}" 
                              SelectedItem="{Binding ValdKund}" 
                              DisplayMemberPath="Namn"/>
                    <Button Grid.Column="1" Width="200" Margin="50, 15" HorizontalAlignment="Right" Content="Ny Kund" Background="#FFB08D46" Click="Button_Click"></Button>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Välj Produkt: " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>
                    <ComboBox Width="250" 
                              ItemsSource="{Binding AllaProdukter}" 
                              SelectedItem="{Binding ValdProdukt}" 
                              DisplayMemberPath="namn"/>
                    <Button Content="Lägg Till" Margin="20,0,0,0" Width="100" Background="#FFB08D46" Command="{Binding LaggTillProduktCommand}"/>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Prioritet: " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>

                    <CheckBox IsChecked="{Binding IsPrioVald}" 
                  Content="Markera som Prio-order (+20% på priset)" 
                  Foreground="White" 
                  VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="15" CornerRadius="10" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rabatt (kr): " Foreground="#FFC5A059" VerticalAlignment="Center" Width="100"/>
                    <TextBox Width="100" Text="{Binding Rabatt}"/>
                    <Button Content="Aktivera Rabatt" Margin="20,0,0,0" Width="130" Background="#FFB08D46" Command="{Binding LaggTillRabattCommand}"/>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="20" CornerRadius="10" Margin="0,10">
                
                    <StackPanel>
                    <TextBlock Text="ORDERÖVERSIKT" Foreground="#FFB08D46" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding OrderOversiktText}" Foreground="White" FontSize="16" Margin="0,0,0,20"/>
                    <Button Content="SPARA ORDER I DATABAS" Height="45" FontSize="18" Background="#FFB08D46" Command="{Binding LaggOrderCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
       </ScrollViewer>
    </Grid>
</Page>