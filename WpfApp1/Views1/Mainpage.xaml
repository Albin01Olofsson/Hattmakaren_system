<Page x:Class="WpfApp1.Views1.Mainpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mainpage" Background="#FF1A1A1D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFC5A059" CornerRadius="0,30,30,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <Button x:Name="BtnLoggaUt" Margin="0,0,0,10" Background="#FFB08D46" BorderThickness="0" Click="BtnLoggaUt_Click">
                        <Border Padding="10,11">
                            <TextBlock Text="Logga ut" FontSize="13.5" FontWeight="Bold" Foreground="#FF2C3E50" HorizontalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Border Padding="10" Background="#22000000" CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Background="#FF2C3E50" CornerRadius="19">
                                <TextBlock Text="👤" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="UserNameText" FontSize="12.5" FontWeight="Bold" Foreground="#FF2C3E50"/>
                                <TextBlock x:Name="RoleText" FontSize="10.5" Foreground="#FF2C3E50" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="20,14,20,0">
                   
                    <Image Source="/Hattmakaren2.png" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,5" 
                    Height="80" 
                    Stretch="Uniform"/>
                   
                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnAnvandare_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Width="27"/>
                                <TextBlock Text="Användare" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnKunder_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Width="27"/>
                                <TextBlock Text="Kunder" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnLager_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎩" Width="27"/>
                                <TextBlock Text="Lager" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnOrder_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Width="27"/>
                                <TextBlock Text="Order" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnSchema_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Width="27"/>
                                <TextBlock Text="Schema" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnBestallningar_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Width="27"/>
                                <TextBlock Text="Beställningar" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnFörfrågningar_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="¿?" Width="27" FontWeight="Bold"/>
                                <TextBlock Text="Förfrågningar" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnReklamation_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩" Width="27"/>
                                <TextBlock Text="Reklamationer" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnLeveranser_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Width="27"/>
                                <TextBlock Text="Leveranser" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Margin="0,1.5" Background="Transparent" BorderThickness="0" Click="BtnStatistik_Click">
                        <Border Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Width="27"/>
                                <TextBlock Text="Statistik" FontSize="14.5" Foreground="#FF2C3E50"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40">

            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />

            <StackPanel x:Name="DashboardStartView">
                <TextBlock Text="Välkommen till hattmakaren" FontSize="28" Foreground="White" Margin="0,0,0,8"/>

                <UniformGrid Columns="2" Margin="0,0,0,30">

                    <Border Background="#FF1E1E1E" Margin="0,0,10,0" Padding="30" CornerRadius="24">
                        <StackPanel>
                            <TextBlock Text="AKTIVA ORDRAR" Foreground="#66FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding AntalAktivaOrdrar}" Foreground="White" FontSize="42" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FF1E1E1E" Margin="10,0,0,0" Padding="30" CornerRadius="24">
                        <StackPanel>
                            <TextBlock Text="TOTALA INTÄKTER" Foreground="#66FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding TotalIntakt, StringFormat='{}{0:N0} kr'}" Foreground="#FFC5A059" FontSize="42" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                
                <Image Source="/Hattmakaren.png" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,22" 
                     Height="400" 
                      Stretch="Uniform"/>

               

            </StackPanel>
            

        </Grid>
    </Grid>
</Page>
