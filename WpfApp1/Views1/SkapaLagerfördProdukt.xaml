<Page x:Class="WpfApp1.Views1.SkapaLagerfördProdukt"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Title="SkapaLagerfördProdukt" Background="#FF1A1A1D">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#FFC5A059"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,20" MaxWidth="800">

            <TextBlock Text="SKAPA LAGERFÖRD PRODUKT" 
                       FontSize="28" 
                       FontWeight="Black" 
                       Foreground="#F4F1EA" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="GRUNDINFORMATION" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Produktnamn" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyttProduktNamn, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pris (kr)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyttPris, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Lagersaldo (st)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyttLagerantal, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="SPECIFIKATIONER" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Storlek" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyStorlek, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Typ" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyTyp, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Modell" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyModell, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Färg" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyFärg, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="ArtikelID" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ArtikelId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Kategori" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Kategori, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Dekoration" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyDecoration, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="MATERIAL" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <TextBlock Text="Välj Material" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding MaterialLista}" 
                                      SelectedItem="{Binding ValdMaterial}" 
                                      DisplayMemberPath="Namn" 
                                      Height="32"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{Binding LäggTillMaterialCommand}" 
                                Content="Lägg till &#x2794;" 
                                Margin="15,22,15,0" 
                                Padding="15,0"
                                Height="32" 
                                Background="#FFC5A059" 
                                FontWeight="Bold" 
                                VerticalAlignment="Top"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valda material:" Style="{StaticResource LabelStyle}"/>
                            <ListBox ItemsSource="{Binding NyMaterialLista}"
                                     DisplayMemberPath="Namn"
                                     Background="#FF1A1A1D"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Height="100"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Command="{Binding LaggTillLagerfordProduktCommand}" 
                    Content="SPARA PRODUKT I DATABAS" 
                    Height="50" 
                    FontSize="18"
                    FontWeight="Black"
                    Background="#FFB08D46"
                    Foreground="Black"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>