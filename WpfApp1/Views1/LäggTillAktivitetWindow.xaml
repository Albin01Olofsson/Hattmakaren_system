<Window x:Class="WpfApp1.Views1.LäggTillAktivitetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lägg till aktivitet"
        Height="300" Width="400"
        Background="#FF1A1A1D">

    <StackPanel Margin="20">

        <TextBox Text="{Binding Titel}" Margin="0,0,0,10"/>

        <DatePicker SelectedDate="{Binding StartDatum}" />

        <TextBox Text="{Binding StartTid}" Margin="0,10,0,0"/>
        <TextBox Text="{Binding SlutTid}" Margin="0,10,0,0"/>

        <Button Content="Spara"
                Command="{Binding SparaAktivitetCommand}"
                Margin="0,20,0,0"/>

    </StackPanel>
</Window>