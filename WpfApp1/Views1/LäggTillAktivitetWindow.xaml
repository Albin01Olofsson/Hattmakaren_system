<Window x:Class="WpfApp1.Views1.LäggTillAktivitetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:conv="clr-namespace:WpfApp1"
        Title="Lägg till aktivitet"
        Height="550" Width="778"
        Background="#FF1A1A1D">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>


    <StackPanel Margin="20">

        <TextBlock Text="Namn" Foreground="#FFC5A059"/>
        <TextBox Text="{Binding Titel}" Margin="0,5,0,10"/>

        <TextBlock Text="Datum" Foreground="#FFC5A059"/>
        <DatePicker SelectedDate="{Binding StartDatum}" Margin="0,5,0,10"/>

        <TextBlock Text="Starttid" Foreground="#FFC5A059"/>
        <ComboBox SelectedItem="{Binding StartTid}">
            <sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32>
            <sys:Int32>10</sys:Int32>
            <sys:Int32>11</sys:Int32>
            <sys:Int32>12</sys:Int32>
            <sys:Int32>13</sys:Int32>
            <sys:Int32>14</sys:Int32>
            <sys:Int32>15</sys:Int32>
            <sys:Int32>16</sys:Int32>
        </ComboBox>

        <TextBlock Text="Sluttid" Foreground="#FFC5A059"/>
        <ComboBox SelectedItem="{Binding SlutTid}">
            <sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32>
            <sys:Int32>10</sys:Int32>
            <sys:Int32>11</sys:Int32>
            <sys:Int32>12</sys:Int32>
            <sys:Int32>13</sys:Int32>
            <sys:Int32>14</sys:Int32>
            <sys:Int32>15</sys:Int32>
            <sys:Int32>16</sys:Int32>
        </ComboBox>

        <TextBlock Text="Deltagare"
           Foreground="#FFC5A059"
           Visibility="{Binding ÄrAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <ListBox x:Name="DeltagarListBox"
         ItemsSource="{Binding AllaAnvändare}"
         SelectionMode="Extended"
         DisplayMemberPath="Namn"
         Height="120"
         Visibility="{Binding ÄrAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Button Content="Spara"
                Command="{Binding SparaAktivitetCommand}"
                Background="#FFB08D46"
                Foreground="Black"
                Margin="0,10,0,0"/>
    </StackPanel>
</Window>