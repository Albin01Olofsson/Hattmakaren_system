<Page x:Class="WpfApp1.Views1.StatistikPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1000"
      Background="#FF1A1A1D"
      Title="StatistikPage">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F1EA"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#182333"
                                BorderBrush="#33485C"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="16,8">
                            <TextBlock x:Name="HeaderText"
                                       Text="{TemplateBinding Header}"
                                       Foreground="#F4F1EA"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFC5A059"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFC5A059"/>
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#FF1A1A1D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFC5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F4F1EA"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFC5A059"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#55708A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="STATISTIK"
                           FontSize="26"
                           FontWeight="Black"/>
                <TextBlock Text="{Binding PeriodText}"
                           Foreground="#FFC5A059"
                           FontWeight="Bold"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Background="#FF2C3E50"
                    CornerRadius="8"
                    Padding="10"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Från" VerticalAlignment="Center" FontWeight="Bold"/>
                    <DatePicker Width="166"
                                SelectedDateFormat="Short"
                                SelectedDate="{Binding DatumFran, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Till" VerticalAlignment="Center" FontWeight="Bold" Margin="12,0,0,0"/>
                    <DatePicker Width="166"
                                SelectedDateFormat="Short"
                                SelectedDate="{Binding DatumTill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Rensa"
                            Command="{Binding RensaDatumFilterCommand}"
                            Background="#FFB08D46"
                            Foreground="#FF1A1A1D"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Nyckeltal}" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF2C3E50"
                            CornerRadius="8"
                            Padding="12"
                            Height="92"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Rubrik}"
                                       Foreground="{Binding AccentFarg}"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding Varde}"
                                       Foreground="#F4F1EA"
                                       FontSize="17"
                                       FontWeight="Black"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Detalj}"
                                       Foreground="#F4F1EA"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.72"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2"
                Background="#FF2C3E50"
                CornerRadius="8"
                Padding="14,12"
                ClipToBounds="True">
            <TabControl>
                <TabItem Header="Hattar">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Sålda hattar"
                                       Foreground="#F4F1EA"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Grid Grid.Row="1" Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hatt" Foreground="#FFC5A059" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Sålda" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Intäkt" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Kunder" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Hattar}"
                                     SelectedItem="{Binding ValdHatt, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#223A5068" CornerRadius="7" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="68"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Namn}" Foreground="#F4F1EA" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Typ}" Foreground="#F4F1EA" Opacity="0.65"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AntalSalda}" Foreground="#F4F1EA" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding IntaktText}" Foreground="#F4F1EA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AntalKunder}" Foreground="#F4F1EA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="#182333" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding ValdHatt.Namn}" Foreground="#F4F1EA" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Köpt av" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding HattDetaljer}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Namn}"
                                                           Foreground="#F4F1EA"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Varde}"
                                                           Foreground="#FFC5A059"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Kunder">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Kunder och köp"
                                       Foreground="#F4F1EA"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Grid Grid.Row="1" Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kund" Foreground="#FFC5A059" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Hattar" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Ordrar" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Totalt" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Kunder}"
                                     SelectedItem="{Binding ValdKund, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#223A5068" CornerRadius="7" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Namn}" Foreground="#F4F1EA" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AntalHattar}" Foreground="#F4F1EA" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AntalOrdrar}" Foreground="#F4F1EA" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TotaltKoptText}" Foreground="#F4F1EA" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="#182333" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding ValdKund.Namn}" Foreground="#F4F1EA" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Har köpt" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding KundDetaljer}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Namn}"
                                                           Foreground="#F4F1EA"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Varde}"
                                                           Foreground="#FFC5A059"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Material">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Materialanvändning"
                                       Foreground="#F4F1EA"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Grid Grid.Row="1" Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Material" Foreground="#FFC5A059" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Beställt" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Hattar" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Lager" Foreground="#FFC5A059" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Material}"
                                     SelectedItem="{Binding ValtMaterial, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#223A5068" CornerRadius="7" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="78"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Namn}" Foreground="#F4F1EA" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding BestalltText}" Foreground="#F4F1EA" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AnvantText}" Foreground="#F4F1EA" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding LagerText}" Foreground="#F4F1EA" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="#182333" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding ValtMaterial.Namn}" Foreground="#F4F1EA" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Användning och inköp" Foreground="#FFC5A059" FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding MaterialDetaljer}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Namn}"
                                                           Foreground="#F4F1EA"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Varde}"
                                                           Foreground="#FFC5A059"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding UppdateradText}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Opacity="0.55"
                   Margin="0,0,12,10"/>
    </Grid>
</Page>
