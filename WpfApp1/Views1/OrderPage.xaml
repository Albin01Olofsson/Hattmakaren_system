<Page x:Class="WpfApp1.Views1.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewmodels="clr-namespace:WpfApp1.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:OrderVM}"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Background="#FF1A1A1D"
      Title="OrderPage">

    <Page.Resources>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#FFB08D46"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC5A059"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="FilterLabelStyle">
            <Setter Property="Foreground" Value="#FFC5A059"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="FrameworkElement" x:Key="FilterControlStyle">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Page.Resources>

    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Rubrik"
                   Text="ORDERHANTERING"
                   Margin="0,0,0,20"
                   FontSize="28"
                   FontWeight="Black"
                   Foreground="#F4F1EA"
                   HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox x:Name="SökFält"
                         Text="{Binding SökString, UpdateSourceTrigger=PropertyChanged}"
                         Width="300"
                         Height="38"
                         FontSize="15"
                         Padding="10,0"
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6,0,0,6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="BtnSök"
                        Content="Sök"
                        Command="{Binding SökCommand}"
                        Width="80"
                        Height="38"
                        Style="{StaticResource ActionButtonStyle}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="+ Gå till Skapa Order" 
                    Click="BtnSkapaOrder_Click" 
                    Height="38" 
                    Style="{StaticResource ActionButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF2C3E50" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="{Binding AntalOrders, StringFormat='Sökresultat: {0} träffar'}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#FFC5A059"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Left"/>

                    <ListBox Grid.Row="1" x:Name="SökResultat"
                             ItemsSource="{Binding OrderList}"
                             SelectionChanged="SökResultat_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF1A1A1D" 
                                        BorderBrush="#FFB08D46" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Kund.Namn}" FontSize="16" FontWeight="Black" Foreground="#F4F1EA"/>
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Datum, StringFormat='Datum: {0:yyyy-MM-dd}'}" FontSize="13" Foreground="#FFC5A059" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding StartadAv.Namn, StringFormat='Säljare: {0}'}" FontSize="13" Foreground="#FFC5A059" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="{Binding OrderID, StringFormat='Ordernr: #{0}'}" FontSize="13" Foreground="LightGray"/>
                                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding IsSpecialbeställning, StringFormat='Special: {0}'}" FontSize="13" Foreground="LightGray" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding OrderStatus, StringFormat='Status: {0}'}" FontSize="13" FontWeight="Bold" Foreground="#FFC5A059" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" x:Name="FilterBar" Background="#FF1A1A1D" BorderBrush="#FF2C3E50" BorderThickness="2" CornerRadius="10" Padding="20">
                <StackPanel Orientation="Vertical">

                    <TextBlock Text="FILTRERING" 
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="#F4F1EA"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Datum Från" Style="{StaticResource FilterLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DatumFrånFilter}" Style="{StaticResource FilterControlStyle}"/>

                    <TextBlock Text="Datum Till" Style="{StaticResource FilterLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DatumTillFilter}" Style="{StaticResource FilterControlStyle}"/>

                    <TextBlock Text="Säljare / Startare" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox x:Name="OrderStartareComboBox"
                              ItemsSource="{Binding OrderStartareNamnList}"
                              SelectedItem="{Binding OrderStartareFilter}"
                              Style="{StaticResource FilterControlStyle}"/>

                    <TextBlock Text="Orderstatus" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox x:Name="OrderStatusComboBox"
                              SelectedValue="{Binding OrderStatusFilter}"
                              SelectedValuePath="Content"
                              SelectedIndex="0"
                              Style="{StaticResource FilterControlStyle}">
                        <ComboBoxItem Content="Alla"/>
                        <ComboBoxItem Content="Ej Påbörjad"/>
                        <ComboBoxItem Content="Påbörjad"/>
                        <ComboBoxItem Content="Levererad"/>
                    </ComboBox>

                    <TextBlock Text="Specialbeställning" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox x:Name="SpecialbeställningComboBox"
                              SelectedValue="{Binding SpecialBeställningFilter}"
                              SelectedValuePath="Content"
                              SelectedIndex="0"
                              Style="{StaticResource FilterControlStyle}">
                        <ComboBoxItem Content="Ospecificerat"/>
                        <ComboBoxItem Content="Ja"/>
                        <ComboBoxItem Content="Nej"/>
                    </ComboBox>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>