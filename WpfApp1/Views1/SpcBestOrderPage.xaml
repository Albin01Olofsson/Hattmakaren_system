<Page x:Class="WpfApp1.Views1.SpcBestOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views1"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="800"
      Title="SpcBestOrderPage" Background="#FF1A1A1D">

    <Page.Resources>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#FFB08D46"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC5A059"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#FFC5A059"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800">

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="SKAPA SPECIALBESTÄLLNING" 
                       FontSize="28" 
                       FontWeight="Black" 
                       Foreground="#F4F1EA" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>
                <Button Grid.Column="2"
                    Content="Se förfrågningar"   
                    Click="ÖppnaFörfråganWindow_Clíck"
                    VerticalAlignment="Center"
                    Width="105" 
                    Height="29" 
                    Margin="0,5,0,30"
                    Style="{StaticResource ActionButtonStyle}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6,6,6,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="GRUNDINFORMATION" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                            <TextBlock Text="Utgå från befintlig modell (Valfritt)" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="ProduktComboBox" 
                                      ItemsSource="{Binding ProduktLista}" 
                                      SelectedItem="{Binding ValdProdukt, UpdateSourceTrigger=PropertyChanged}" 
                                      DisplayMemberPath="Namn" 
                                      Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Specialbeställningens Namn" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyttProduktNamn, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Ange Pris (kr)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyttPris, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="SPECIFIKATIONER" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Storlek" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyStorlek, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Typ" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyTyp, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Modell" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyModell, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Färg" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyFärg, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Dekoration" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyDecoration, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="MATERIAL" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <TextBlock Text="Välj Material" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="MaterialComboBox" 
                                      ItemsSource="{Binding MaterialLista}" 
                                      SelectedItem="{Binding ValdMaterial}" 
                                      DisplayMemberPath="Namn" 
                                      Height="32"
                                      SelectionChanged="ComboBox_SelectionChanged"/>
                            <TextBlock Text="Mängd" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ValdMängd, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{Binding LäggTillMaterialCommand}" 
                                Content="Lägg till &#x2794;" 
                                Margin="15,22,15,0" 
                                Padding="15,0"
                                Height="32" 
                                Style="{StaticResource ActionButtonStyle}"
                                VerticalAlignment="Top"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valda material:" Style="{StaticResource LabelStyle}"/>
                            <ListBox ItemsSource="{Binding NyMaterialLista}" Background="#FF1A1A1D" Foreground="White"
                                    BorderThickness="0" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Material.Namn}" Width="150" Foreground="White"/>
                                            <TextBlock Text="{Binding Mängd}" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                            </ListBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FF2C3E50" Padding="25" CornerRadius="10" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="EXTRA INFORMATION" FontWeight="Bold" Foreground="#F4F1EA" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kundens Beskrivning" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NyBeskrivning, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="120" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" 
                                     SpellCheck.IsEnabled="True"
                                     VerticalContentAlignment="Top"
                                     Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Referensbild" Style="{StaticResource LabelStyle}"/>
                            <Border Background="#FF1A1A1D" CornerRadius="5" Height="120" Margin="0,0,0,10" ClipToBounds="True">
                                <Image Source="{Binding ValdBild}" Stretch="Uniform" Margin="5"/>
                            </Border>
                            <Button Click="BtnLaddaUppBild_Click" 
                                    Content="Ladda upp bild" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Height="32" Padding="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Command="{Binding LäggTillSpecialBeställningCommand}" 
                    Content="SPARA SPECIALBESTÄLLNING" 
                    Height="50" 
                    FontSize="18"
                    Style="{StaticResource ActionButtonStyle}"/>

        </StackPanel>
    </ScrollViewer>
</Page>