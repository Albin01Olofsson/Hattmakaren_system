<Window x:Class="WpfApp1.Views1.AddKundWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:local="clr-namespace:WpfApp1.Views1"
       mc:Ignorable="d"
       Title="Ny Kund" Height="450" Width="778"
       Background="#FF1A1A1D"
       WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Background="#FF2C3E50"
               Padding="20"
               CornerRadius="15"
               Margin="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                <!-- Titel -->
                <TextBlock Text="Ny Kund"
                          FontSize="22"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>

                <!-- Namn -->
                <TextBlock Text="Namn"
                          Foreground="#FFC5A059"/>
                <TextBox Text="{Binding Namn, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,5,0,10"/>

                <!-- Email -->
                <TextBlock Text="Email"
                          Foreground="#FFC5A059"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,5,0,10"/>

                <!-- Telefon -->
                <TextBlock Text="Telefon"
                          Foreground="#FFC5A059"/>
                <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,5,0,10"/>

                <!-- Adress -->
                <TextBlock Text="Adress"
                          Foreground="#FFC5A059"/>
                <TextBox Text="{Binding Adress, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,5,0,20"/>

                <TextBlock Text="Land"
           Foreground="#FFC5A059"/>
                <TextBox Text="{Binding Land, UpdateSourceTrigger=PropertyChanged}"
         Margin="0,5,0,20"/>


                <TextBlock Text="Stad"
           Foreground="#FFC5A059"/>
                <TextBox Text="{Binding Stad, UpdateSourceTrigger=PropertyChanged}"
         Margin="0,5,0,20"/>

                <!-- Knapp -->
                <Button Content="Spara"
                       Height="40"
                       Background="#FFB08D46"
                       Foreground="Black"
                       FontWeight="Bold"
                       Command="{Binding AddKundCommand}"/>

            </StackPanel>
                </ScrollViewer>
        </Border>
    </Grid>
</Window>
